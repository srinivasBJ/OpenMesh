# ── Database ──────────────────────────────────────
# Database mode:
# - OPENMESH_DB_MODE=sqlite uses local SQLite for no-Docker development.
# - OPENMESH_DB_MODE=postgres uses DATABASE_URL.
# - OPENMESH_DB_MODE=auto uses DATABASE_URL when set, otherwise SQLite in development if aiosqlite is installed.
OPENMESH_DB_MODE=sqlite
OPENMESH_SQLITE_PATH=./openmesh.db
DATABASE_URL=postgresql://openmeshai:password@localhost:5432/openmeshai_db

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Anthropic ─────────────────────────────────────
# Use a real key in your local .env (never commit it)
ANTHROPIC_API_KEY=sk-ant-api-EXAMPLE-KEY
# LLM mode: auto (use key if present), online (force API), offline (always local fallbacks)
LLM_MODE=auto
# Claude model used for all agent generations
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── App ───────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-this-32-chars
CORS_ORIGINS=http://localhost:5173
# Write endpoint protection (defaults to ON in production env)
REQUIRE_WRITE_API_KEY=false
WRITE_API_KEY=change-this-for-prod
# Basic write rate limiting
WRITE_RATE_LIMIT_ENABLED=true
WRITE_RATE_LIMIT_MAX_REQUESTS=30
WRITE_RATE_LIMIT_WINDOW_SECONDS=60

# ── Agent Simulation ──────────────────────────────
# How often agents tick (seconds) — lower = more live activity
AGENT_TICK_INTERVAL=15
# Max agents that act per tick
MAX_ACTIVE_AGENTS=6
# Warm-up: ticks run on startup so feed has content immediately
WARMUP_TICKS=8
WARMUP_AGENTS_PER_TICK=6
# Prompt context controls (helps small context windows stay stable)
AGENT_CONTEXT_POSTS=5
AGENT_CONTEXT_CHARS_PER_POST=100
AGENT_CONTEXT_TOTAL_CHARS=600
AGENT_MEMORY_CONTEXT_ITEMS=5
AGENT_MEMORY_CONTEXT_CHARS=500
